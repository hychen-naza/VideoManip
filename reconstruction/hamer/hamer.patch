+def export_hand_mesh_2d_raw(verts, cam_t, faces, out_path, fx, fy, cx, cy):
+    verts_cam = verts + cam_t  # (N, 3)
+    x = verts_cam[:, 0]
+    y = verts_cam[:, 1]
+    z = verts_cam[:, 2]
+    u = fx * (x / z) + cx
+    v = fy * (y / z) + cy
+    verts_2d = np.stack([u, v, np.zeros_like(u)], axis=1)
+    mesh_2d = trimesh.Trimesh(vertices=verts_2d, faces=faces)
+    mesh_2d.export(out_path)
