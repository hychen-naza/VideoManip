+    def rotation_matrix_to_axis_angle(self, rotation_matrix):
+        """
+        Convert 3x3 rotation matrix to axis-angle representation.
+        
+        Args:
+            rotation_matrix: 3x3 rotation matrix (torch.Tensor) or batch of matrices (batch_size, 3, 3)
+            
+        Returns:
+            axis_angle: 3-element tensor [rx, ry, rz] representing axis-angle rotation
+        """
+        # Handle batch dimension
+        if rotation_matrix.dim() == 3:
+            batch_size = rotation_matrix.shape[0]
+            axis_angles = []
+            for i in range(batch_size):
+                R = rotation_matrix[i]
+                axis_angle = self._single_rotation_matrix_to_axis_angle(R)
+                axis_angles.append(axis_angle)
+            return torch.stack(axis_angles, dim=0)
+        else:
+            return self._single_rotation_matrix_to_axis_angle(rotation_matrix)
+    
+    def _single_rotation_matrix_to_axis_angle(self, R):
+        """
+        Convert a single 3x3 rotation matrix to axis-angle representation.
+        """
+        # Ensure R is 2D
+        if R.dim() == 3:
+            R = R.squeeze(0)
+        # Extract the rotation angle and axis
+        # Using the formula: angle = arccos((trace(R) - 1) / 2)
+        trace = torch.trace(R)
+        angle = torch.arccos(torch.clamp((trace - 1) / 2, -1, 1))
+        
+        if torch.abs(angle) < 1e-6:
+            # If angle is very small, return zero rotation
+            return torch.zeros(3, device=R.device, dtype=R.dtype)
+        
+        # Extract the rotation axis
+        # Using the formula: axis = (R - R^T) / (2 * sin(angle))
+        skew_symmetric = (R - R.T) / (2 * torch.sin(angle))
+        axis = torch.tensor([skew_symmetric[2, 1], skew_symmetric[0, 2], skew_symmetric[1, 0]], 
+                           device=R.device, dtype=R.dtype)
+        
+        # Return axis-angle representation (axis * angle)
+        return axis * angle
+    
+    def rotation_matrix_to_axis_angle_vectorized(self, rotation_matrix):
+        """
+        Vectorized version of rotation matrix to axis-angle conversion.
+        
+        Args:
+            rotation_matrix: 3x3 rotation matrix (torch.Tensor) or batch of matrices (batch_size, 3, 3)
+            
+        Returns:
+            axis_angle: 3-element tensor [rx, ry, rz] representing axis-angle rotation
+        """
+        # Ensure we have the right shape
+        if rotation_matrix.dim() == 2:
+            rotation_matrix = rotation_matrix.unsqueeze(0)
+        
+        batch_size = rotation_matrix.shape[0]
+        
+        # Extract the rotation angle and axis for all matrices at once
+        # Using the formula: angle = arccos((trace(R) - 1) / 2)
+        trace = torch.diagonal(rotation_matrix, dim1=-2, dim2=-1).sum(dim=-1)
+        angle = torch.arccos(torch.clamp((trace - 1) / 2, -1, 1))
+        
+        # Handle small angles
+        small_angle_mask = torch.abs(angle) < 1e-6
+        angle = torch.where(small_angle_mask, torch.zeros_like(angle), angle)
+        
+        # Extract the rotation axis
+        # Using the formula: axis = (R - R^T) / (2 * sin(angle))
+        R_transpose = rotation_matrix.transpose(-2, -1)
+        skew_symmetric = (rotation_matrix - R_transpose) / (2 * torch.sin(angle).unsqueeze(-1).unsqueeze(-1))
+        
+        # Extract the axis components
+        axis_x = skew_symmetric[:, 2, 1]
+        axis_y = skew_symmetric[:, 0, 2]
+        axis_z = skew_symmetric[:, 1, 0]
+        axis = torch.stack([axis_x, axis_y, axis_z], dim=-1)
+        
+        # Return axis-angle representation (axis * angle)
+        result = axis * angle.unsqueeze(-1)
+        
+        # Handle small angles by setting to zero
+        result = torch.where(small_angle_mask.unsqueeze(-1), torch.zeros_like(result), result)
+        
+        return result.squeeze(0) if batch_size == 1 else result
+
+    def convert_mano_to_manotorch_params(self, pred_mano_params):
