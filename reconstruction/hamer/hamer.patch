+            # Convert global orientation for this batch element
+            global_orient_matrix = pred_mano_params['global_orient'][i]  # Shape: (3, 3)
+            global_axis_angle = self._single_rotation_matrix_to_axis_angle(global_orient_matrix)
+            
+            # Convert hand pose for this batch element
+            hand_pose_matrices = pred_mano_params['hand_pose'][i]  # Shape: (15, 3, 3)
